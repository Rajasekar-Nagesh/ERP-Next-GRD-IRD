# Variables for the Railway app service. Set these in the Railway dashboard
# (Service -> Variables), not in a committed file.

# --- Required ------------------------------------------------------------
# Admin password for the site's Administrator user. Required on first deploy.
ADMIN_PASSWORD=change-me

# --- Database ------------------------------------------------------------
# mariadb (default) or postgres.
DB_TYPE=mariadb
# Reference the database service's variables instead of hardcoding, e.g.
#   DB_HOST=${{MariaDB.RAILWAY_PRIVATE_DOMAIN}}
#   DB_PORT=3306
#   DB_ROOT_USER=root
#   DB_ROOT_PASSWORD=${{MariaDB.MARIADB_ROOT_PASSWORD}}
# If left unset, Railway's MYSQLHOST/MYSQLPORT/MYSQLUSER/MYSQLPASSWORD
# (or PGHOST/PGPORT/PGUSER/PGPASSWORD) are used automatically.
DB_HOST=
DB_PORT=
DB_ROOT_USER=
DB_ROOT_PASSWORD=

# --- Redis ---------------------------------------------------------------
# Full redis:// URLs. If unset, REDIS_PRIVATE_URL / REDIS_URL are used, e.g.
#   REDIS_CACHE=${{Redis.REDIS_PRIVATE_URL}}
#   REDIS_QUEUE=${{Redis.REDIS_PRIVATE_URL}}
REDIS_CACHE=
REDIS_QUEUE=

# --- Site ----------------------------------------------------------------
# Defaults to RAILWAY_PUBLIC_DOMAIN. Set explicitly when using a custom domain
# so the site name stays stable across domain changes.
SITE_NAME=
# Comma separated list of apps installed on first deploy.
INSTALL_APPS=erpnext
# Run `bench migrate` on every deploy (1) or never (0).
AUTO_MIGRATE=1

# --- Tuning --------------------------------------------------------------
GUNICORN_WORKERS=2
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=120
CLIENT_MAX_BODY_SIZE=50m
PROXY_READ_TIMEOUT=120
